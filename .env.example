# Copy this file to .env and replace every change-me value.

MYSQL_PORT=3306
MYSQL_DATABASE=lucking
MYSQL_USER=lucking
MYSQL_PASSWORD=change-me
MYSQL_ROOT_PASSWORD=change-me

CLICKHOUSE_HTTP_PORT=8123
CLICKHOUSE_NATIVE_PORT=9000
CLICKHOUSE_DATABASE=lucking
CLICKHOUSE_USER=lucking
CLICKHOUSE_PASSWORD=change-me

REDIS_PORT=6379
REDIS_PASSWORD=change-me

PREFECT_PORT=4200

# Investment workbench server configuration. Never expose these as VITE_* variables.
APP_ENVIRONMENT=development
SESSION_COOKIE_NAME=lucking_session
SESSION_IDLE_TIMEOUT_SECONDS=1800
SESSION_ABSOLUTE_TIMEOUT_SECONDS=28800
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_SAMESITE=lax
SESSION_COOKIE_PATH=/
CSRF_HEADER_NAME=X-CSRF-Token
WORKBENCH_TIMEZONE=Asia/Shanghai
DAILY_TASK_SUMMARY_HOUR=20
FEISHU_WEBHOOK_URL=
FEISHU_SIGNING_SECRET=

# Trading calendar synchronization (never put a real token here)
DATABASE_URL=mysql+pymysql://lucking:change-me@127.0.0.1:3306/lucking
TRADING_CALENDAR_PROVIDER=tushare
TUSHARE_TOKEN=replace-with-local-secret
TUSHARE_API_URL=https://api.tushare.pro

# Monthly broker recommendations (Tushare broker_recommend)
BROKER_RECOMMENDATION_PROVIDER=tushare
BROKER_RECOMMENDATION_TIMEZONE=Asia/Shanghai
BROKER_RECOMMENDATION_LOG_DIR=logs
BROKER_RECOMMENDATION_LOG_FILENAME=broker-recommendation-sync.jsonl
BROKER_RECOMMENDATION_FETCH_DEADLINE_SECONDS=1500
BROKER_RECOMMENDATION_RUN_LEASE_SECONDS=2100
BROKER_RECOMMENDATION_TIMELINESS_TARGET_MS=1800000
BROKER_RECOMMENDATION_PAGE_LIMIT=1000
BROKER_RECOMMENDATION_MAX_PAGES=100
# Enable only after the deployment account proves limit/offset semantics.
BROKER_RECOMMENDATION_TUSHARE_PAGINATION_ENABLED=false
BROKER_RECOMMENDATION_BACKFILL_MAX_MONTHS=120

TRADING_CALENDAR_LOG_DIR=logs
TRADING_CALENDAR_TIMEZONE=Asia/Shanghai

# Daily stock-list synchronization (CN-S always includes SSE, SZSE and BSE)
STOCK_LIST_PROVIDER=tushare
STOCK_LIST_SCOPE=CN-S
STOCK_LIST_TIMEZONE=Asia/Shanghai
STOCK_LIST_LOG_DIR=logs
STOCK_LIST_LOG_FILENAME=stock-list-sync.jsonl
STOCK_LIST_FETCH_DEADLINE_SECONDS=1500
STOCK_LIST_TIMELINESS_TARGET_MS=1800000
STOCK_LIST_SEGMENT_ROW_CAP=6000
